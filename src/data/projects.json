    {
      "id": "videoart",
      "title": "Video Art",
      "hasIndividualPages": false,
      "route": "/works/videoart",
      "heroImages": ["images/videoart/silhouettes.png"],
      "blurb": "Video art & short film projects, including Qatsi, which was nominated for Best Visual and awarded Best Sound at the 2024 MIT AI Film Hackathon.",
      "items": [
        {
          "id": "qatsi",
          "title": "Qatsi",
          "image": "images/videoart/qatsi.jpg",
          "youtubeUrl": "https://youtu.be/Qy7D2O2zytc",
          "alt": "Qatsi",
          "tags": [
            "AI Short Film",
            "Nominated Best Visual",
            "Awarded Best Sound"
          ],
          "blurb": "An homage to the 1982 film Koyaanisqatsi, “Qatsi” is a visual exploration of motion as the axiom of life—spanning the vastness of the cosmos, the rhythms of nature, and the intimacy of human connection. Created for the MIT AI Filmmaking Hackathon, Qatsi was recognized as a Finalist and received the Best Sound Award, along with an Honorable Mention for Best Visual."
        },
        {
          "id": "alteregos",
          "title": "Alter Egos",
          "image": "images/videoart/alteregos.png",
          "youtubeUrl": "https://youtu.be/T4Bfi2lBTCE",
          "alt": "Alter Egos",
          "tags": ["Promotion", "Performance", "Montage"],
          "blurb": "As the Graduate Teaching Assistant for Alter Egos: Assuming New Identities Through Costume and Performance, I was responsible for preparing promotional materials for the end of semester performance. I edited this video in Premiere from footage of previous performances. I wanted the class/performance to seem like an eclectic party, and I played with blending modes to layer performances (especially in pairs) to connect to the concept of duality."
        },
        {
          "id": "areyoufree",
          "title": "Are You Free Tomorrow?",
          "image": "images/videoart/areyoufree.png",
          "youtubeUrl": "https://youtu.be/L0l2DRwhbiM",
          "alt": "Are You Free Tomorrow?",
          "tags": ["Short Film", "Visual Poetry", "Montage"],
          "blurb": "Are You Free Tomorrow? is a rhythmic montage that explores the feeling of being overwhelmed by too many possibilities. Edited in Adobe After Effects."
        },
        {
          "id": "silhouettes",
          "title": "Silhouettes",
          "image": "images/videoart/silhouettes.png",
          "youtubeUrl": "https://youtu.be/tZa94F7IT3w",
          "alt": "Silhouettes",
          "tags": ["Short Film", "Visual Poetry", "Montage"],
          "blurb": "Silhouettes is a visual poem / montage that contemplates identity and self-perception. Edited in Adobe Premiere Pro."
        }
      ]

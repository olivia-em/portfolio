      "id": "frontend",
      "title": "Frontend Development",
      "hasIndividualPages": true,
      "heroImage": "images/frontend/LIP/LIP1.png",
      "blurb": "Lessons in Perspective is an interactive, web-based poetry collection that explores how every relationship is shaped by the ones that came before it. Built with React and Three.js, this collection makes the browser a space for 3D concrete poetry. Your interaction with the present can unravel the past, illustrating connections that are invisible but felt. Lessons in Perspective offers a poetic meditation on love, memory, and the invisible architectures of life.",
      "items": [
        {
          "id": "lip",
          "title": "Lessons in Perspective",
          "slug": "lip",
          "route": "/works/frontend/lip",
          "image": "images/frontend/LIP/LIP1.png",
          "extraImages": ["images/frontend/LIP/LIP2.png"],
          "alt": "LIP thumbnail",
          "year": null,
          "description": "Lessons in Perspective is an interactive, web-based poetry collection that explores how every relationship is shaped by the ones that came before it. Built with React and Three.js, this collection makes the browser a space for 3D concrete poetry. Clicking, rotating, and exploring the 3D environment reveals how meaning changes with perspective; your interaction with the present can unravel the past, illustrating connections that are invisible but felt. Lessons in Perspective offers a poetic meditation on love, memory, and the invisible architectures of life.",
          "tags": ["React", "Three.js", "Poetry"],
          "url": {
            "repository": "https://github.com/olivia-em/inperspective",
            "website": "https://lessons-inperspective.netlify.app/",
            "documentation": ""
          },
          "heroImage": "images/frontend/LIP/LIP1.png",
          "blurb": "Lessons in Perspective is an interactive, web-based poetry collection built with React and Three.js."
        },
